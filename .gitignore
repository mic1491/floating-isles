# Fab asset (Sakura Dragon): licensed per user, get it from Fab instead of the repo
unreal/*/Content/SakuraDragon/
unreal/*/Content/Collections/
unreal/*/Content/Developers/
# Epic's mannequin pack: copied from the engine by unreal/StormIsle/Tools/get_mannequin.sh
unreal/StormIsle/Content/Characters/

# Raw downloads of free asset packs; Tools/import_packs.py imports them into Content/Packs
unreal/_downloads/
# Fab assets: Open World Demo Collection (trees, rocks) and Faymere River Village
unreal/*/Content/KiteDemo/
unreal/*/Content/FaymereVillage/
unreal/*/Content/Materials/Trees/
