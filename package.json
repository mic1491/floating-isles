{
  "name": "floating-isles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && npm run fighter:build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "fighter": "vite fighter --port 5174",
    "fighter:build": "tsc --noEmit -p fighter && vite build fighter"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@pixiv/three-vrm": "^3.5.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
